#!/usr/bin/env python3
"""Regenerate the donor-based example and its typed observation view."""
from pathlib import Path
import shutil
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from p4bridge.translate import generate
from pbt.observations import generate_view


def main():
    source = ROOT / 'specifications/p4record'
    committed = source / 'Generated'
    with tempfile.TemporaryDirectory() as directory:
        project = Path(directory)
        shutil.copyfile(ROOT / 'lean-toolchain', project / 'lean-toolchain')
        fresh = project / 'specifications/p4record/Generated'
        generate(project, fresh, source / 'observations.toml', [source / 'spec.watsup'])
        for name in ['Spec.lean', 'Transport.lean', 'manifest.json', 'observations.toml']:
            if (fresh / name).read_bytes() != (committed / name).read_bytes():
                raise SystemExit(f'Generated example differs: {committed / name}')
        view = project / 'View.lean'
        generate_view(ROOT, fresh / 'manifest.json', source / 'observations.toml', 'value',
                      'specifications.p4record.Generated.Transport', 'P4View', view)
        if view.read_bytes() != (ROOT / 'pbt/p4record/View.lean').read_bytes():
            raise SystemExit('Generated observation view differs: pbt/p4record/View.lean')
    print('Verified direct donor output, transport, metadata and observation view')


if __name__ == '__main__':
    main()
