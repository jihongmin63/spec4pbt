#!/usr/bin/env python3
"""Run the locally built SpecTec-to-Lean translator with its original CLI."""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from p4bridge.toolchain import resolve_toolchain

try:
    executable = resolve_toolchain().executable
    os.execv(executable, [str(executable), *sys.argv[1:]])
except (OSError, ValueError) as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
