var x : nat
var y : nat
var u : nat
var z : nat

relation E1: nat nat nat hint(input %0)
rule E1/spec: x y u
  -- if y = 7
  -- if u = 99
relation E2: nat nat hint(input %0)
rule E2/spec: y z
  -- if z = $(y + 1)

relation Pre: nat nat hint(input %0)
rule Pre/main: x z
  -- E1: x y u
  -- if u = 99
  -- E2: y z

relation Goal: nat nat hint(input %0 %1)
rule Goal/main: x z
  -- if z = $(x + 3)
