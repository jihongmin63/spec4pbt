import @PROOF@
import Spec4Pbt.CorrectGen

namespace ClauseProgressGenerator
open Gen.CorrectGen
open @CONTRACT@

private def certified : CorrectGen Premise :=
  convert (by
    funext input
    apply propext
    constructor
    · rintro ⟨n, _, rfl⟩
      exact ⟨n, ClauseProgress.internal_refl n⟩
    · intro _
      exact ⟨input.«n», True.intro, by cases input; rfl⟩)
    (s_bind s_arbNat (fun n => s_pure ({ «n» := n } : Input)))

def generator : generatorValue := certified.val

theorem soundness : generatorSound generator := by
  intro input h
  exact (Iff.of_eq (congrFun certified.property input)).mp h

theorem completeness : generatorComplete generator := by
  intro input h
  exact (Iff.of_eq (congrFun certified.property input)).mpr h

theorem lawfulness : generatorLawful generator := by
  change Gen.IndexLawful (Gen.arbNat >>= fun n => pure ({ «n» := n } : Input))
  simp

end ClauseProgressGenerator
