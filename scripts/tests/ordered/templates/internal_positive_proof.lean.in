import @CONTRACT@

namespace ClauseInternal

theorem internal_refl (n : Nat) : SpecTec.Internal n n := by
  refine ⟨0, ?_⟩
  apply SpecTecExecution.Eval.call
  change SpecTecExecution.Eval SpecTec.specTecProgram
    (SpecTecExecution.firstSuccess (SpecTec.Internal_clauses n) ()) 0
    (.success (.of n)) 0
  apply SpecTecExecution.firstSuccess_cons_success
  change SpecTecExecution.Eval SpecTec.specTecProgram (.pure n) 0
    (.success (.of n)) 0
  exact SpecTecExecution.Eval.pure n

theorem internal_eq (n x : Nat) (h : SpecTec.Internal n x) : x = n := by
  rcases h with ⟨final, h⟩
  rcases internal_refl n with ⟨_, href⟩
  have det : SpecTecExecution.PrimitiveDeterministic SpecTec.specTecProgram := by
    intro request a b ha
    cases ha
  have heq := (SpecTecExecution.eval_deterministic det h href).1
  cases heq
  rfl

theorem property_correct : @CONTRACT@.property := by
  intro input _
  change decide (input.«n» = input.«n») = true
  exact decide_eq_true rfl

end ClauseInternal
