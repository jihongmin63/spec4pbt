import @CONTRACT@

namespace ClauseInternal

theorem internal_refl (n : Nat) : SpecTec.Internal n n := by
  refine ⟨0, ?_⟩
  apply SpecTecExecution.Eval.call
  change SpecTecExecution.Eval SpecTec.Body
    (SpecTecExecution.tryClauses (SpecTec.Internal_clauses n)) 0
    (.success (.of n)) 0
  apply SpecTecExecution.tryClauses_cons_success
  change SpecTecExecution.Eval SpecTec.Body (.pure n) 0
    (.success (.of n)) 0
  exact SpecTecExecution.Eval.pure n

theorem internal_eq (n x : Nat) (h : SpecTec.Internal n x) : x = n := by
  rcases h with ⟨final, h⟩
  obtain ⟨_, known⟩ : ∃ a : SpecTecExecution.Eval SpecTec.Body
      (.call ⟨Nat, SpecTec.Call.Internal n⟩) 0 (.success (.of n)) 0,
      SpecTecExecution.Functional SpecTec.Body a :=
    ⟨_, .call (.orElse_success (.pure n))⟩
  have heq := (SpecTecExecution.eval_deterministic known h).1
  cases heq
  rfl

theorem property_correct : @CONTRACT@.property := by
  intro input _
  change decide (input.«n» = input.«n») = true
  exact decide_eq_true rfl

end ClauseInternal
