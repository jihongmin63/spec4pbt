import @PROOF@
import pbt.CorrectGen

namespace ClauseChainGenerator
open Gen.CorrectGen
open @CONTRACT@

def generator : CorrectGen Premise :=
  convert (by
    funext input
    apply propext
    constructor
    · rintro ⟨n, _, rfl⟩
      exact ⟨n, n, ClauseChain.copy_refl n, ClauseChain.copy_refl n⟩
    · intro _
      exact ⟨input.«n», True.intro, by cases input; rfl⟩)
    (s_bind s_arbNat (fun n => s_pure ({ «n» := n } : Input)))

end ClauseChainGenerator
