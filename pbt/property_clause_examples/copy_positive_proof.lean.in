import @CONTRACT@

namespace ClauseCopy

theorem copy_refl (n : Nat) : SpecTec.Copy n n := by
  refine ⟨0, ?_⟩
  apply SpecTecExecution.Eval.call
  change SpecTecExecution.Eval SpecTec.specTecProgram
    (SpecTecExecution.firstSuccess (SpecTec.Copy_clauses n) ()) 0
    (.success (.of n)) 0
  apply SpecTecExecution.firstSuccess_cons_success
  change SpecTecExecution.Eval SpecTec.specTecProgram (.pure n) 0
    (.success (.of n)) 0
  exact SpecTecExecution.Eval.pure n

theorem copy_eq (n v : Nat) (h : SpecTec.Copy n v) : v = n := by
  rcases h with ⟨final, h⟩
  rcases copy_refl n with ⟨_, href⟩
  have det : SpecTecExecution.PrimitiveDeterministic SpecTec.specTecProgram := by
    intro request x y hx
    cases hx
  have heq := (SpecTecExecution.eval_deterministic det h href).1
  cases heq
  rfl

theorem property_correct : @CONTRACT@.SpecProperty := by
  intro input v _
  change decide (v = v) = true
  exact decide_eq_true rfl

theorem reference_run_correct :
    @CONTRACT@.SpecProperty →
    ∀ (input : @CONTRACT@.Input),
      @CONTRACT@.Premise input → @CONTRACT@.ReferenceRun input := by
  intro _ input premise
  rcases premise with ⟨v, hc⟩
  have positive : input.«n» > 0 := by
    have hv := copy_eq input.«n» v hc.1
    subst v
    simpa [@CONTRACT@.Conditions] using hc.2
  constructor
  · change True → ∃ w : Nat, SpecTec.Copy input.«n» w
    intro _
    exact ⟨input.«n», copy_refl input.«n»⟩
  · intro actual hcopy
    have heq := copy_eq input.«n» actual hcopy
    subst actual
    constructor
    · exact decide_eq_true positive
    constructor
    · exact decide_eq_true rfl
    · intro _
      exact decide_eq_true rfl

end ClauseCopy
