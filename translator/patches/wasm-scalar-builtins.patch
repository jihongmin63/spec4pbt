+def finiteArithmetic (width : Nat) (op : String) (x y : Nat) : Nat :=
+  let (nx, dx) := fraction width x
+  let (ny, dy) := fraction width y
+  let sx := negative width x
+  let sy := negative width y != (op == "sub")
+  let intermediateWidth := if width = 32 then 64 else width
+  let result := if op == "mul" then
