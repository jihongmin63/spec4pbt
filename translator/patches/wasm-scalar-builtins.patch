+      else if ix || zy then signedBits width (sx != sy) (infinity width)
+      else if iy then signedBits width (sx != sy) 0
+      else finiteArithmetic width op x y
+    else
+      if ix && iy && sx != sy then quietNaN width
+      else if ix then x
+      else if iy then signedBits width sy (infinity width)
+      else finiteArithmetic width op x y
+
+/-- Integer square root by a bounded binary search; the fuel covers the whole interval. -/
+def sqrtSearch (n : Nat) : Nat → Nat → Nat → Nat
+  | 0, lo, _ => lo
+  | fuel + 1, lo, hi =>
+    let mid := (lo + hi + 1) / 2
+    if mid * mid ≤ n then sqrtSearch n fuel mid hi
+    else sqrtSearch n fuel lo (mid - 1)
