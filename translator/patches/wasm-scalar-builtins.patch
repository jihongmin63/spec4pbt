+let source = {wasm_scalar|
+/- Exact bit-level implementation of the wasm-ntt Fxx and conversion helpers.
+   Operations on f32 reproduce the donor's intermediate binary64 rounding.
+   No host floating-point primitives, axioms, or compiler replacements are used. -/
+namespace SpecTecWasmFloat
+
+def mantissa (width : Nat) : Nat := if width = 32 then 23 else 52
+def exponent (width : Nat) : Nat := if width = 32 then 8 else 11
+def bias (width : Nat) : Nat := 2 ^ (exponent width - 1) - 1
+def signMask (width : Nat) : Nat := 2 ^ (width - 1)
+def infinity (width : Nat) : Nat := (2 ^ exponent width - 1) * 2 ^ mantissa width
+def quietNaN (width : Nat) : Nat := infinity width + 2 ^ (mantissa width - 1)
+def magnitude (width bits : Nat) : Nat := bits % signMask width
+def negative (width bits : Nat) : Bool := bits / signMask width % 2 == 1
+def isNaN (width bits : Nat) : Bool := magnitude width bits > infinity width
+def isInf (width bits : Nat) : Bool := magnitude width bits == infinity width
+def isZero (width bits : Nat) : Bool := magnitude width bits == 0
+def signedBits (width : Nat) (sign : Bool) (mag : Nat) : Nat :=
+  (if sign then signMask width else 0) + mag
+def quiet (width bits : Nat) : Nat := Nat.lor bits (quietNaN width)
+def binaryNaN (width x y : Nat) : Nat :=
+  quiet width (if isNaN width x then x else if isNaN width y then y else quietNaN width)
+
+/-- Exact unsigned rational value of a finite bit pattern. -/
+def fraction (width bits : Nat) : Nat × Nat :=
+  let m := mantissa width
+  let mag := magnitude width bits
+  let e := mag / 2 ^ m
+  let f := mag % 2 ^ m
+  let significand := if e = 0 then f else 2 ^ m + f
+  let power : Int := (if e = 0 then 1 else (e : Int)) - (bias width : Int) - (m : Int)
+  if power ≥ 0 then (significand * 2 ^ power.toNat, 1)
+  else (significand, 2 ^ (-power).toNat)
+
+def ratioLog2 (n d : Nat) : Int :=
+  let estimate : Int := (n.log2 : Int) - (d.log2 : Int)
+  let below := if estimate ≥ 0 then n < d * 2 ^ estimate.toNat
+    else n * 2 ^ (-estimate).toNat < d
+  if below then estimate - 1 else estimate
+
+def scaledRatio (n d : Nat) (unitPower : Int) : Nat × Nat :=
+  if unitPower ≥ 0 then (n, d * 2 ^ unitPower.toNat)
+  else (n * 2 ^ (-unitPower).toNat, d)
+
+/-- Round a nonnegative rational to the nearest integer, ties to even. -/
+def roundRatio (n d : Nat) : Nat :=
+  let q := n / d
+  let r := n % d
+  if 2 * r > d ∨ (2 * r = d ∧ q % 2 = 1) then q + 1 else q
+
+def packRounded (width : Nat) (sign : Bool) (significand : Nat) (unitPower : Int) : Nat :=
+  let m := mantissa width
+  let (s, power) := if significand ≥ 2 ^ (m + 1)
+    then (significand / 2, unitPower + 1) else (significand, unitPower)
+  let rawExponent : Int := power + (m : Int) + (bias width : Int)
+  let mag := if s < 2 ^ m then s
+    else if rawExponent ≥ (2 ^ exponent width - 1 : Nat) then infinity width
+    else rawExponent.toNat * 2 ^ m + (s - 2 ^ m)
+  signedBits width sign mag
+
+def ofRatio (width : Nat) (sign : Bool) (n d : Nat) : Nat :=
+  if n = 0 then signedBits width sign 0 else
+  let m := mantissa width
+  let minPower : Int := 1 - (bias width : Int) - (m : Int)
+  let unitPower := max (ratioLog2 n d - (m : Int)) minPower
+  let (a, b) := scaledRatio n d unitPower
+  packRounded width sign (roundRatio a b) unitPower
+
+/-- IEEE promote/demote, including the reference interpreter's NaN payload rule. -/
+def convert (srcWidth dstWidth bits : Nat) : Nat :=
+  if srcWidth = dstWidth then bits else
+  let sign := negative srcWidth bits
+  if isNaN srcWidth bits then
+    let payload := magnitude srcWidth bits % 2 ^ mantissa srcWidth
+    let mapped := if mantissa dstWidth ≥ mantissa srcWidth
