+def sqrtNat (n : Nat) : Nat :=
+  let bits := n.log2 / 2 + 1
+  sqrtSearch n (bits + 1) 0 (2 ^ bits)
+
+def sqrtRounded (width : Nat) (n d : Nat) : Nat :=
+  if n = 0 then 0 else
+  let m := mantissa width
+  let minPower : Int := 1 - (bias width : Int) - (m : Int)
+  let unitPower := max (ratioLog2 n d / 2 - (m : Int)) minPower
+  let (a, b) := scaledRatio n d (2 * unitPower)
+  let q := sqrtNat (a / b)
+  let midpoint := b * (2 * q + 1) ^ 2
+  let rounded := if 4 * a > midpoint ∨ (4 * a = midpoint ∧ q % 2 = 1) then q + 1 else q
