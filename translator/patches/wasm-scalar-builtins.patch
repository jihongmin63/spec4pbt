+  let arguments = List.mapi (fun i typ -> L.Variable ("input" ^ string_of_int i, typ)) parameters in
+  let output = L.Variable ("result", result) in
+  let application target args : L.application =
+    { target = L.Global ("$" ^ target); type_arguments = [];
+      instance_arguments = []; print_instance_arguments = []; compare_instance_arguments = []; arguments = args } in
+  let compute : L.builtin =
+    { name = "$" ^ helper; type_parameters = []; equality_parameters = [];
+      print_parameters = []; compare_parameters = []; parameters; result = option result; body } in
+  let rule : L.rule =
+    { name = "success";
+      binders = List.mapi (fun i typ -> "input" ^ string_of_int i, typ) parameters @ ["result", result];
+      premises = [L.Prop (L.Comparison (L.Eq, L.Apply (application helper arguments),
