+  | I31HT -> "I31HT"
+  | StructHT -> "StructHT"
+  | ArrayHT -> "ArrayHT"
+  | FuncHT -> "FuncHT"
+  | NoFuncHT -> "NoFuncHT"
+  | ExnHT -> "ExnHT"
+  | NoExnHT -> "NoExnHT"
+  | ExternHT -> "ExternHT"
+  | NoExternHT -> "NoExternHT"
+  | BotHT -> "BotHT"
