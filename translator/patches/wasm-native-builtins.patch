+    symbols #@ "instr"
+  | CallRef idx ->
+    let symbols = [ Term "CALL_REF"; NT (il_of_idx "typeidx" (idx.it $ no_region)) ] in
+    symbols #@ "instr"
+  | CallIndirect (idx1, idx2) ->
