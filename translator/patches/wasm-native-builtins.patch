+(* Compatibility with the pinned SpecTec runtime's immutable list values. *)
+let of_list values = values
+let init = List.init
+let length = List.length
+let rec drop n values = if n = 0 then values else match values with
+  | [] -> invalid_arg "Value_array.drop"
+  | _ :: rest -> drop (n - 1) rest
+let rec take n values = if n = 0 then [] else match values with
+  | [] -> invalid_arg "Value_array.take"
+  | value :: rest -> value :: take (n - 1) rest
+let sub values start count =
+  if start < 0 || count < 0 || start > length values - count then
+    invalid_arg "Value_array.sub";
+  take count (drop start values)
+let replace_slice values ~pos replacement =
+  let count = length replacement in
+  if pos < 0 || pos > length values - count then invalid_arg "Value_array.replace_slice";
+  take pos values @ replacement @ drop (pos + count) values
