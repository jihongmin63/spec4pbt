+and match_field_type c (FieldT (mut1, st1)) (FieldT (mut2, st2)) =
+  mut1 = mut2 && match_storage_type c st1 st2 &&
+  match mut1 with
+  | Cons -> true
+  | Var -> match_storage_type c st2 st1
