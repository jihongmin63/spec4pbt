@@ -15,3 +15,27 @@ let algo_defs (spec : spec) : (Al.def, error) result list =
   List.map (fun def ->
     try Ok (Binding.Analyze.analyze_def ctx def |> Sidecondition.Guard.insert_def)
     with Error.AlgoError d -> Error d) spec
+
+(* Normalize each property premise as its own AL block. The first block group
+   contains source conditions; the final block is the goal and its helpers. *)
+let algo_property spec (_, inputs, goal, conditions) =
+  try
+    let ctx = Binding.Ctx.load_spec (Binding.Ctx.init ()) spec in
+    let venv = List.fold_left (fun env (id, typ) ->
+      Runtime.Static.Envs.VEnv.add id (typ, []) env)
+      Runtime.Static.Envs.VEnv.empty inputs in
+    let ctx = Binding.Ctx.add_bounds ctx venv in
+    let ctx = Binding.Ctx.add_frees ctx (Il.Free.free_prems (conditions @ [goal])) in
+    let convert (ctx, must, blocks) prem =
+      let ctx, bounds, normalized, sideconditions =
+        Binding.Analyze.analyze_prem ctx Binding.Iterctx.empty prem in
+      let bindings = Runtime.Static.Envs.VEnv.bindings bounds
+        |> List.map (fun (id, (typ, _)) -> (id, typ)) in
+      let ctx = Binding.Ctx.add_bounds ctx bounds in
+      let must, nodes = Sidecondition.Guard.insert_prems must
+        (normalized :: sideconditions) in
+      (ctx, must, blocks @ [(nodes, bindings)]) in
+    let ctx, must, blocks = List.fold_left convert (ctx, [], []) conditions in
+    let _, _, goal_blocks = convert (ctx, must, []) goal in
+    Ok (blocks, List.hd goal_blocks)
+  with Error.AlgoError d -> Error d
