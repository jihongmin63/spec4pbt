 let elab_spec (spec : El.spec) : (Il.spec, error) result =
   try Ok (Elab.elab_spec spec) with Error.ElabError d -> Error d
+
+open Lang
+open Util.Source
+
+let elab_property spec (name, inputs, goal, conditions) =
+  try
+    let ctx, _ = Elab.elab_defs (Ctx.init ()) spec in
+    let frees = El.Free.free_id_prems (goal :: conditions) in
+    let ctx = Domain.Lib.IdSet.fold (fun id (ctx : Ctx.t) -> {ctx with menv = Domain.Lib.IdMap.remove (Lang.Xl.Var.strip_var_suffix id) ctx.menv}) frees ctx |> fun ctx -> Ctx.add_frees ctx frees in
+    let seen = Hashtbl.create 8 in
+    let ctx, inputs = List.fold_left_map (fun ctx ((id : El.id), typ) ->
+      if Hashtbl.mem seen id.it then Error.error id.at "duplicate property input";
+      Hashtbl.add seen id.it ();
+      let typ = Elab.elab_plaintyp ctx typ in
+      let ctx = {ctx with menv = Domain.Lib.IdMap.remove (Lang.Xl.Var.strip_var_suffix id) ctx.menv} in Ctx.add_metavar ctx id typ, (id, typ)) ctx inputs in
+    let elaborate ctx p =
+      (match p.it with El.IfPr _ | El.RulePr _ | El.VarPr _ -> ()
+        | _ -> Error.error p.at "unsupported property premise");
+      let ctx, p = Elab.elab_prem ctx p in
+      ctx, Elab.externalize_prem p in
+    Elab.property_variables := true;
+    Fun.protect ~finally:(fun () -> Elab.property_variables := false) (fun () ->
+      let ctx, conditions = List.fold_left_map elaborate ctx conditions in
+      let _, goal = elaborate ctx goal in
+      Ok (name, inputs, Option.get goal, List.filter_map Fun.id conditions))
+  with Error.ElabError d -> Error d
