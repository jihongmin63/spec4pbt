+def wrap (width : Nat) (value : Int) : Nat := (value % (2 ^ width : Nat)).toNat
+def signed (width value : Nat) : Int :=
+  let value := value % 2 ^ width
+  if value < 2 ^ (width - 1) then value else (value : Int) - 2 ^ width
+def lane (width value index : Nat) : Nat := (value / 2 ^ (width * index)) % 2 ^ width
+def pack (width : Nat) (values : List Nat) : Nat :=
+  values.foldr (fun value rest => value % 2 ^ width + 2 ^ width * rest) 0
+def lanes (width value : Nat) : List Nat := (List.range (128 / width)).map (lane width value)
+def mapLanes (width : Nat) (f : Nat → Nat) (value : Nat) : Nat := pack width ((lanes width value).map f)
+def zipLanes (width : Nat) (f : Nat → Nat → Nat) (a b : Nat) : Nat :=
+  pack width ((lanes width a).zipWith f (lanes width b))
+def clamp (width : Nat) (isSigned : Bool) (x : Int) : Nat :=
+  let lo : Int := if isSigned then -(2 ^ (width - 1) : Nat) else 0
+  let hi : Int := if isSigned then (2 ^ (width - 1) : Nat) - 1 else (2 ^ width : Nat) - 1
+  wrap width (max lo (min hi x))
