+def integerVectorConvert (width : Nat) (op : String) (value : Nat) : Option Nat :=
+  if ["ExtendLowS", "ExtendLowU", "ExtendHighS", "ExtendHighU", "ExtAddPairwiseS", "ExtAddPairwiseU"].contains op then
+    if !(width == 16 || width == 32 || width == 64) || (width == 64 && ["ExtAddPairwiseS", "ExtAddPairwiseU"].contains op) then none else
