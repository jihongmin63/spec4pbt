+def integerBinary (width : Nat) (op : String) (left right : Nat) : Option Nat :=
+  let a := left % 2 ^ width
+  let b := right % 2 ^ width
+  let sa := signed width a
+  let sb := signed width b
+  let shift := b % width
+  match op with
+  | "Add" | "IAdd" => some (wrap width ((a : Int) + b))
+  | "Sub" | "ISub" => some (wrap width ((a : Int) - b))
+  | "Mul" | "IMul" => some (wrap width ((a : Int) * b))
+  | "IDivS" => if b == 0 || (sa == -(2 ^ (width - 1) : Nat) && sb == -1) then none else some (wrap width (Int.tdiv sa sb))
+  | "IDivU" => if b == 0 then none else some (a / b)
+  | "IRemS" => if b == 0 then none else some (wrap width (Int.tmod sa sb))
+  | "IRemU" => if b == 0 then none else some (a % b)
+  | "IAnd" => some (Nat.land a b)
+  | "IOr" => some (Nat.lor a b)
+  | "IXor" => some (Nat.xor a b)
+  | "Shl" | "IShl" => some ((a * 2 ^ shift) % 2 ^ width)
+  | "ShrU" | "IShrU" => some (a / 2 ^ shift)
+  | "ShrS" | "IShrS" => some (wrap width (Int.shiftRight sa shift))
+  | "IRotl" => some ((a * 2 ^ shift + a / 2 ^ (width - shift)) % 2 ^ width)
+  | "IRotr" => some ((a / 2 ^ shift + a * 2 ^ (width - shift)) % 2 ^ width)
