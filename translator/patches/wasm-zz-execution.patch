+  | "Clz" => some (((List.range width).reverse.takeWhile (fun i => value / 2 ^ i % 2 == 0)).length)
+  | "Ctz" => some (((List.range width).takeWhile (fun i => value / 2 ^ i % 2 == 0)).length)
