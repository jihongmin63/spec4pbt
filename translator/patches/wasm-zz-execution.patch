+  | "Eq" => a == b
+  | "Ne" => a != b
+  | "LtS" => sa < sb
+  | "LtU" => a < b
+  | "GtS" => sa > sb
+  | "GtU" => a > b
+  | "LeS" => sa ≤ sb
+  | "LeU" => a ≤ b
+  | "GeS" => sa ≥ sb
+  | "GeU" => a ≥ b
+  | _ => false
