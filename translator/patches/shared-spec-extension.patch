+
+
+(** Acyclic authored relations are plans over the imported base request family.
+    Inline helper calls as plans, never as logical premises: ordered failure,
+    aborts, fallback, and the shared fresh supply are consequently unchanged.
+    In particular notHold still requires Eval ... unmatch, not absence of a
+    successful derivation. The base Program and every base declaration remain
+    the exact imported constants. *)
+let transpile_extension ~base_module ~helpers source =
+  try
+    let identifier text =
+      let alpha = function 'a'..'z' | 'A'..'Z' | '_' -> true | _ -> false in
+      let alnum ch = alpha ch || (ch >= '0' && ch <= '9') || ch = '\'' in
+      String.length text > 0 && alpha text.[0] && String.for_all alnum text in
+    if not (List.for_all identifier (String.split_on_char '.' base_module)) then
+      Translator.unsupported no_region "invalid shared base Lean module name";
+    let helpers = List.sort_uniq String.compare helpers in
+    let env, declarations, _ = declarations source ~keep_going:false in
+    let all = List.map (fun d -> d.L.declaration) declarations in
+    Printer.configure all;
+    let signatures = signatures env (external_names source) all in
+    let local = List.map (fun name ->
+      match List.find_opt (fun d -> Order.defined_name d.L.declaration = name) declarations with
+      | Some ({L.declaration = L.Relation _; _} as d)
+          when not (M.find name signatures).E.external_ -> name, d
+      | _ -> Translator.unsupported no_region
+          ("extension helper is not a defined relation: " ^ name)) helpers in
+    let dependencies d = match d.L.declaration with
+      | L.Relation r -> List.concat_map (fun (rule : L.rule) -> rule.premises) r.rules
+          |> List.map Order.premise_references |> Order.unions
+          |> Order.StringSet.elements |> List.filter (fun n -> List.mem n helpers)
+      | _ -> [] in
+    let rec visit path (seen, ordered) name =
+      if List.mem name path then Translator.unsupported (List.assoc name local).L.at
+        ("recursive helper extension is unsupported: "
+          ^ String.concat " -> " (List.rev (name :: path))
+          ^ "; rewrite helpers without recursion before shared translation");
+      if List.mem name seen then seen, ordered else
+      let d = List.assoc name local in
+      let seen, ordered = List.fold_left (visit (name :: path))
+        (seen, ordered) (dependencies d) in
+      name :: seen, ordered @ [d] in
+    let _, ordered = List.fold_left (visit []) ([], []) helpers in
+    let chunks = ref [] in
+    let add text = chunks := text :: !chunks in
+    let instances eq print = String.concat ""
+      (List.map (fun n -> " [_root_.DecidableEq " ^ ident n ^ "]") eq
+       @ List.map (fun n -> " [_root_.SpecTecPrint " ^ ident n ^ "]") print) in
+    let type_binders names = String.concat ""
+      (List.map (fun n -> " (" ^ ident n ^ " : Type)") names) in
+    let arg_binders bound args = String.concat ""
+      (List.map (fun (n,t) -> " (" ^ n ^ " : " ^ call_type bound t ^ ")") args) in
+    List.iter (fun d -> match d.L.declaration with
+      | L.Relation r ->
+          let s = M.find r.name signatures in
+          let args = List.mapi (fun i typ -> "input" ^ string_of_int i, typ)
+            (E.input_types s) in
+          let shared = type_binders r.type_parameters
+            ^ instances r.equality_parameters r.print_parameters in
+          let applied = String.concat " " (List.map ident r.type_parameters @ List.map fst args) in
+          let clauses = List.mapi (fun i (rule : L.rule) ->
+            let name = ident (r.name ^ ":clause:" ^ string_of_int i) in
+            let params, body, _ = compile ~helpers ~executable:false env signatures s rule d.at in
+            add ("noncomputable def " ^ name ^ shared ^ " " ^ params
+              ^ " : SpecTecExecution.Plan.{1} SpecTecRequest :=\n  " ^ body);
+            "fun (_ : _root_.Unit) => " ^ name ^ " " ^ applied) r.rules in
+          add ("noncomputable def " ^ ident (r.name ^ "_clauses") ^ shared
+            ^ arg_binders r.type_parameters args
+            ^ " : List (SpecTecExecution.Clause.{1, 0} SpecTecRequest _root_.Unit) :=\n  ["
+            ^ String.concat ", " clauses ^ "]");
+          add ("noncomputable def " ^ ident (r.name ^ "_plan") ^ shared
+            ^ arg_binders r.type_parameters args
+            ^ " : SpecTecExecution.Plan.{1} SpecTecRequest :=\n  SpecTecExecution.firstSuccess ("
+            ^ ident (r.name ^ "_clauses") ^ " " ^ applied ^ ") ()");
+          let all = List.mapi (fun i typ -> "arg" ^ string_of_int i, typ) s.arguments in
+          let inputs, outputs = E.split s all in
+          let output = List.map (fun (n,t) -> L.Variable (n,t)) outputs
+            |> E.tuple_term |> Printer.print_term r.type_parameters in
+          add ("noncomputable def " ^ ident r.name ^ shared
+            ^ arg_binders r.type_parameters all ^ " : Prop :=\n  ∃ finalSupply : Nat, "
+            ^ "SpecTecExecution.Eval specTecProgram (" ^ ident (r.name ^ "_plan") ^ " "
+            ^ String.concat " " (List.map ident r.type_parameters @ List.map fst inputs)
+            ^ ") 0 (.success (.of (" ^ output ^ "))) finalSupply"
+            ^ (match r.notation with None -> "" | Some n -> "\n\n" ^ Printer.print_notation r.name n))
+      | _ -> assert false) ordered;
+    Ok ("import " ^ base_module ^ "\n\nset_option autoImplicit false\n"
+      ^ "set_option maxHeartbeats 4000000\nset_option maxRecDepth 4096\n\nnamespace SpecTec\n\n"
+      ^ String.concat "\n\n" (List.rev !chunks) ^ "\n\nend SpecTec\n")
+  with Translator.Unsupported_il d -> Error d
