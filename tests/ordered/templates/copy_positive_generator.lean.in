import @PROOF@
import Spec4Pbt.CorrectGen

namespace ClauseCopyGenerator
open Gen.CorrectGen
open @CONTRACT@

def generator : CorrectGen Premise :=
  convert (by
    funext input
    apply propext
    constructor
    · rintro ⟨n, _, rfl⟩
      exact ⟨n + 1, ClauseCopy.copy_refl (n + 1),
        decide_eq_true (Nat.zero_lt_succ n)⟩
    · rintro ⟨v, hc, hg⟩
      have hv := ClauseCopy.copy_eq input.«n» v hc
      subst v
      have hn : input.«n» > 0 := by simpa using hg
      obtain ⟨n, h⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
      exact ⟨n, True.intro, by cases input; simp_all [Nat.succ_eq_add_one]⟩)
    (s_bind s_arbNat (fun n => s_pure ({ «n» := n + 1 } : Input)))

end ClauseCopyGenerator
