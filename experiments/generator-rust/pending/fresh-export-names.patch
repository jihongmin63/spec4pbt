+++ b/experiments/generator-rust/proofs/WasmFreshNameChoice.lean
@@ -0,0 +1,77 @@
+import WasmFreshNamePrimitives
+import Lean.Util.CollectAxioms
+
+set_option autoImplicit false
+set_option maxHeartbeats 1600000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust wasm.natural
+
+/-- Every original unused finite name has an exact finite execution prefix. -/
+theorem fresh_name_replay (name : List Nat) (used : List (List Nat))
+    (fresh : name ∉ used) (rest trace : List U64) (offset work : Nat) :
+    wasm.names.fresh (sequenceLiteral (used.map nameLiteral))
+      (replayState (freshNameCells used name ++ rest) trace offset
+        (work + (freshNameCells used name).length)) =
+      Result.ok (.Ok (nameLiteral name,
+        replayState rest ((freshNameCells used name).reverse ++ trace)
+          (offset + (freshNameCells used name).length) work)) := by
+  induction name generalizing used trace offset work with
+  | nil =>
+      have stop := pick_word_state 2#u64 0#u64 rest trace offset work (by decide)
+      rw [wasm.names.fresh]
+      simp [contains_empty_names, fresh, freshNameCells, nameLiteral, sequenceLiteral,
+        stop, core.result.Result.Insts.CoreOpsTry.branch]
+  | cons head tail ih =>
+      have tailFresh : tail ∉ nameTails used head := by
+        intro present
+        exact fresh ((mem_name_tails used head tail).mp present)
+      by_cases blocked : [] ∈ used
+      · have headRun := natural_literal_choice head (freshNameCells (nameTails used head) tail ++ rest)
+          trace offset (work + (freshNameCells (nameTails used head) tail).length)
+        have tailRun := ih (nameTails used head) tailFresh
+          ((naturalCells (naturalLiteral head)).reverse ++ trace)
+          (offset + (naturalCells (naturalLiteral head)).length) work
+        rw [wasm.names.fresh]
+        simp [freshNameCells, blocked, List.append_assoc, List.reverse_append,
+          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] at headRun tailRun ⊢
+        simp only [contains_empty_names, blocked, decide_true, bind_ok, ↓reduceIte]
+        rw [headRun]
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          ↓uncurry_apply_pair, matching_name_tails]
+        rw [tailRun]
+        simp [wasm.sequence.cons, nameLiteral, sequenceLiteral]
+      · have more := pick_word_state 2#u64 1#u64
+          (naturalCells (naturalLiteral head) ++ (freshNameCells (nameTails used head) tail ++ rest))
+          trace offset (work + (freshNameCells (nameTails used head) tail).length +
+            (naturalCells (naturalLiteral head)).length) (by decide)
+        have headRun := natural_literal_choice head (freshNameCells (nameTails used head) tail ++ rest)
+          (1#u64 :: trace) (offset + 1) (work + (freshNameCells (nameTails used head) tail).length)
+        have tailRun := ih (nameTails used head) tailFresh
+          ((naturalCells (naturalLiteral head)).reverse ++ 1#u64 :: trace)
+          (offset + 1 + (naturalCells (naturalLiteral head)).length) work
+        rw [wasm.names.fresh]
+        simp [freshNameCells, blocked, List.append_assoc, List.reverse_append,
+          Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] at more headRun tailRun ⊢
+        simp only [contains_empty_names, blocked, decide_false, bind_ok, ↓reduceIte]
+        rw [more]
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          ↓uncurry_apply_pair, ↓reduceIte]
+        rw [headRun]
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          ↓uncurry_apply_pair, matching_name_tails]
+        rw [tailRun]
+        simp [wasm.sequence.cons, nameLiteral, sequenceLiteral]
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``name_literal_roundtrip, ``name_literal_inverse, ``mem_name_tails,
+      ``copy_name_literal, ``contains_empty_names, ``matching_name_tails,
+      ``fresh_name_cells_empty, ``fresh_name_replay] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
