+++ b/experiments/generator-rust/src/wasm/names.rs
@@ -0,0 +1,61 @@
+use super::choices::{self, pick_word, Choices, GenerationError};
+use super::natural::{self, Natural};
+use super::sequence::{self, Sequence};
+use super::type_matching::same_natural;
+
+pub(super) fn copy(name: &Sequence<Natural>) -> Sequence<Natural> {
+    match name {
+        Sequence::Empty => Sequence::Empty,
+        Sequence::Cons(cell) => sequence::cons(natural::copy(&cell.0), copy(&cell.1)),
+    }
+}
+
+fn contains_empty(used: &Sequence<Sequence<Natural>>) -> bool {
+    match used {
+        Sequence::Empty => false,
+        Sequence::Cons(cell) => match &cell.0 {
+            Sequence::Empty => true,
+            Sequence::Cons(_) => contains_empty(&cell.1),
+        },
+    }
+}
+
+/// Retain exactly the forbidden suffixes after the chosen prefix component.
+fn matching_tails(used: Sequence<Sequence<Natural>>, head: &Natural)
+    -> Sequence<Sequence<Natural>>
+{
+    match used {
+        Sequence::Empty => Sequence::Empty,
+        Sequence::Cons(cell) => {
+            let (name, rest): (Sequence<Natural>, Sequence<Sequence<Natural>>) = *cell;
+            let tail: Sequence<Sequence<Natural>> = matching_tails(rest, head);
+            match name {
+                Sequence::Empty => tail,
+                Sequence::Cons(name) => {
+                    if same_natural(&name.0, head) {
+                        sequence::cons(name.1, tail)
+                    } else {
+                        tail
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// A forbidden complete prefix removes only the stop alternative at that prefix.
+pub(super) fn fresh(used: Sequence<Sequence<Natural>>, choices: Choices)
+    -> Result<(Sequence<Natural>, Choices), GenerationError>
+{
+    let (more, choices): (u64, Choices) = if contains_empty(&used) {
+        (1, choices)
+    } else {
+        pick_word(2, choices)?
+    };
+    if more == 0 {
+        return Ok((Sequence::Empty, choices));
+    }
+    let (head, choices): (Natural, Choices) = choices::natural(choices)?;
+    let (tail, choices): (Sequence<Natural>, Choices) = fresh(matching_tails(used, &head), choices)?;
+    Ok((sequence::cons(head, tail), choices))
+}
