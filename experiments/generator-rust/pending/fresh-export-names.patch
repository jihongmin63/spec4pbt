+++ b/experiments/generator-rust/proofs/WasmFreshNamePrimitives.lean
@@ -0,0 +1,93 @@
+import WasmTypeMatchingPrimitives
+import WasmNaturalChoice
+
+set_option autoImplicit false
+set_option maxHeartbeats 1600000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust wasm.natural wasm.sequence
+
+def nameCells : List Natural → List U64
+  | [] => [0#u64]
+  | head :: tail => 1#u64 :: (naturalCells head ++ nameCells tail)
+
+def nameLiteral (values : List Nat) : Sequence Natural :=
+  sequenceLiteral (values.map naturalLiteral)
+
+theorem name_literal_roundtrip (values : List Nat) :
+    (sequenceValues (nameLiteral values)).map naturalValue = values := by
+  simp [nameLiteral, List.map_map, Function.comp_def]
+
+@[simp] theorem natural_literal_inverse (value : Natural) :
+    naturalLiteral (naturalValue value) = value := by
+  apply naturalValue_injective
+  simp
+
+@[simp] theorem name_literal_inverse (name : Sequence Natural) :
+    nameLiteral ((sequenceValues name).map naturalValue) = name := by
+  simp [nameLiteral, List.map_map, Function.comp_def]
+
+/-- Forbidden suffixes retain source order and duplicates. -/
+def nameTails : List (List Nat) → Nat → List (List Nat)
+  | [], _ => []
+  | [] :: rest, head => nameTails rest head
+  | (first :: tail) :: rest, head =>
+      if first = head then tail :: nameTails rest head else nameTails rest head
+
+theorem mem_name_tails (used : List (List Nat)) (head : Nat) (tail : List Nat) :
+    tail ∈ nameTails used head ↔ head :: tail ∈ used := by
+  induction used with
+  | nil => simp [nameTails]
+  | cons candidate rest ih =>
+      cases candidate with
+      | nil => simpa [nameTails] using ih
+      | cons first suffix =>
+          by_cases same : first = head
+          · subst first
+            simp [nameTails, ih]
+          · simp [nameTails, same, ih, Ne.symm same]
+
+theorem copy_name_literal (name : List Nat) :
+    wasm.names.copy (nameLiteral name) = Result.ok (nameLiteral name) := by
+  induction name with
+  | nil => rfl
+  | cons head tail ih =>
+      simp [nameLiteral, sequenceLiteral, wasm.names.copy, wasm.sequence.cons, ih]
+
+theorem contains_empty_names (used : List (List Nat)) :
+    wasm.names.contains_empty (sequenceLiteral (used.map nameLiteral)) =
+      Result.ok (decide ([] ∈ used)) := by
+  induction used with
+  | nil => rfl
+  | cons name rest ih =>
+      cases name <;> simp [wasm.names.contains_empty, sequenceLiteral, nameLiteral, ih]
+
+theorem matching_name_tails (used : List (List Nat)) (head : Nat) :
+    wasm.names.matching_tails (sequenceLiteral (used.map nameLiteral)) (naturalLiteral head) =
+      Result.ok (sequenceLiteral ((nameTails used head).map nameLiteral)) := by
+  induction used with
+  | nil => rfl
+  | cons name rest ih =>
+      cases name with
+      | nil =>
+          simp [wasm.names.matching_tails, sequenceLiteral, nameLiteral, nameTails, ih]
+      | cons first tail =>
+          by_cases same : first = head
+          all_goals
+            simp [wasm.names.matching_tails, sequenceLiteral, nameLiteral, nameTails,
+              ih, same_natural_total, same, wasm.sequence.cons]
+
+/-- Stop is omitted only at a prefix that is itself already forbidden. -/
+def freshNameCells (used : List (List Nat)) : List Nat → List U64
+  | [] => [0#u64]
+  | head :: tail =>
+      (if [] ∈ used then [] else [1#u64]) ++ naturalCells (naturalLiteral head) ++
+        freshNameCells (nameTails used head) tail
+
+theorem fresh_name_cells_empty (name : List Nat) :
+    freshNameCells [] name = nameCells (name.map naturalLiteral) := by
+  induction name with
+  | nil => rfl
+  | cons head tail ih => simp [freshNameCells, nameTails, nameCells, ih]
+
+end RustWasm
