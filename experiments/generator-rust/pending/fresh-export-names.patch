diff --git a/experiments/generator-rust/native/tests/wasm_export_names.rs b/experiments/generator-rust/native/tests/wasm_export_names.rs
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/native/tests/wasm_export_names.rs
@@ -0,0 +1,95 @@
+use generator_rust::wasm::{replay, sized_config};
+use generator_rust::wasm::choices::{Source, Tape};
+use generator_rust::wasm::natural;
+
+#[path = "../src/wasm_choice_serialization.rs"]
+mod wasm_choice_serialization;
+#[path = "../src/wasm_serialization.rs"]
+mod wasm_serialization;
+
+fn natural_cells(number: u128) -> Vec<u64> {
+    if number == 0 {
+        return vec![0];
+    }
+    let mut result: Vec<u64> = vec![1u64 << 32];
+    let mut rest: u128 = number;
+    while rest > 1 {
+        result.push(if rest % 2 == 0 { 1 } else { 2 });
+        rest /= 2;
+    }
+    result.push(0);
+    result
+}
+
+fn name_cells(used: &[Vec<u128>], name: &[u128]) -> Vec<u64> {
+    let empty_used: bool = used.iter().any(Vec::is_empty);
+    let Some((head, tail)) = name.split_first() else {
+        assert!(!empty_used, "test targets must have distinct names");
+        return vec![0];
+    };
+    let mut cells: Vec<u64> = if empty_used { vec![] } else { vec![1] };
+    cells.extend(natural_cells(*head));
+    let suffixes: Vec<Vec<u128>> = used.iter()
+        .filter_map(|candidate| candidate.split_first()
+            .filter(|(first, _)| *first == head)
+            .map(|(_, rest)| rest.to_vec()))
+        .collect();
+    cells.extend(name_cells(&suffixes, tail));
+    cells
+}
+
+fn check_names(names: Vec<Vec<u128>>) {
+    let count: u64 = u64::try_from(names.len()).expect("test export count fits u64");
+    let mut cells: Vec<u64> = vec![1, 1, 0, 0, 0, 0, 1, 0, count];
+    for (index, name) in names.iter().enumerate() {
+        cells.push(0);
+        cells.extend(name_cells(&names[..index], name));
+    }
+    cells.extend([0, 0]);
+    let offset: u64 = u64::try_from(cells.len()).expect("test tape length fits u64");
+    let expected_trace: String = format!("[{}]",
+        cells.iter().map(u64::to_string).collect::<Vec<String>>().join(","));
+    let tape: Tape = cells.into_iter().rev().fold(Tape::Empty,
+        |tail, head| Tape::Cons(head, Box::new(tail)));
+    let mut config = sized_config(0, offset + 1);
+    config.max_types = natural::from_u64(1);
+    config.max_functions = natural::from_u64(1);
+    config.max_exports = natural::from_u64(count);
+    let (module, final_state) = match replay(config, tape) {
+        Ok(output) => output,
+        Err(error) => panic!("full replay must preserve arbitrary export names: {}",
+            wasm_serialization::error_message(error)),
+    };
+    assert!(matches!(final_state.remaining, natural::Natural::Zero));
+    match final_state.source {
+        Source::Replay(Tape::Empty, actual) =>
+            assert_eq!(wasm_choice_serialization::natural_decimal(&actual), offset.to_string()),
+        _ => panic!("full replay must consume the exact export-name tape"),
+    }
+    assert_eq!(wasm_choice_serialization::trace_json(&final_state.trace), expected_trace);
+    let exports: String = names.iter().map(|name| {
+        let values: String = name.iter().map(u128::to_string).collect::<Vec<String>>().join(",");
+        format!("{{\"NAME\":[{values}],\"EDESC\":{{\"FuncExport\":0}}}}")
+    }).collect::<Vec<String>>().join(",");
+    let expected: String = format!(concat!(
+        "{{\"TYPES\":[{{\"RecT\":[{{\"SubT\":[\"Final\",[],{{\"DefFuncT\":{{\"FuncT\":[[],[]]}}}}]}}]}}],",
+        "\"GLOBALS\":[],\"TABLES\":[],\"MEMS\":[],\"TAGS\":[],",
+        "\"FUNCS\":[{{\"FTYPE\":0,\"LOCALS\":[],\"BODY\":[]}}],",
+        "\"START\":null,\"ELEMS\":[],\"DATAS\":[],\"IMPORTS\":[],\"EXPORTS\":[{}]}}"), exports);
+    assert_eq!(wasm_serialization::module_json(&module), expected);
+}
+
+#[test]
+fn full_replay_preserves_unbounded_distinct_export_names() {
+    check_names(vec![vec![]]);
+    check_names(vec![vec![0, 1 << 32, 1 << 64, (1 << 80) + 5]]);
+    check_names(vec![vec![], vec![0], vec![0, 0], vec![0, 1], vec![1],
+        vec![1, 0], vec![(1 << 80) + 5], vec![0, 0, 0], vec![2]]);
+    check_names(vec![vec![7, 8], vec![7], vec![], vec![7, 8, 9], vec![7, 9], vec![8]]);
+}
+
+#[test]
+fn full_replay_preserves_long_names_and_export_lists() {
+    check_names(vec![vec![0; 129], vec![0; 128], vec![]]);
+    check_names((0u128..129).map(|value| vec![value]).collect());
+}
