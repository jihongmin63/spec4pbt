diff --git a/experiments/generator-rust/native/tests/wasm_constant_globals.rs b/experiments/generator-rust/native/tests/wasm_constant_globals.rs
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/native/tests/wasm_constant_globals.rs
@@ -0,0 +1,87 @@
+use generator_rust::wasm::{natural, replay, sized_config};
+use generator_rust::wasm::choices::{Source, Tape};
+
+#[path = "../src/wasm_choice_serialization.rs"]
+mod wasm_choice_serialization;
+#[path = "../src/wasm_serialization.rs"]
+mod wasm_serialization;
+
+fn natural_cells(number: u128) -> Vec<u64> {
+    if number < 1 << 32 {
+        return vec![u64::try_from(number).expect("small test number fits u64")];
+    }
+    let mut cells: Vec<u64> = vec![1 << 32];
+    let mut remaining: u128 = number;
+    while remaining > 1 {
+        cells.push(if remaining % 2 == 0 { 1 } else { 2 });
+        remaining /= 2;
+    }
+    cells.push(0);
+    cells
+}
+
+fn globals_report(maximum: usize, cells: Vec<u64>) -> String {
+    let offset: u64 = u64::try_from(cells.len()).expect("test tape length fits u64");
+    let expected_trace: String = format!("[{}]",
+        cells.iter().map(u64::to_string).collect::<Vec<String>>().join(","));
+    let mut config = sized_config(maximum, offset);
+    config.max_types = natural::Natural::Zero;
+    config.max_functions = natural::Natural::Zero;
+    config.max_parameters = natural::Natural::Zero;
+    config.max_results = natural::Natural::Zero;
+    config.max_locals = natural::Natural::Zero;
+    config.max_exports = natural::Natural::Zero;
+    config.fuel = natural::Natural::Zero;
+    config.max_memories = natural::Natural::Zero;
+    config.max_datas = natural::Natural::Zero;
+    config.max_memory_imports = natural::Natural::Zero;
+    let tape: Tape = wasm_choice_serialization::tape_from_cells(cells);
+    let (module, final_state) = match replay(config, tape) {
+        Ok(output) => output,
+        Err(error) => panic!("full replay must construct constant globals: {}",
+            wasm_serialization::error_message(error)),
+    };
+    assert!(matches!(final_state.remaining, natural::Natural::Zero));
+    match final_state.source {
+        Source::Replay(Tape::Empty, actual) =>
+            assert_eq!(wasm_choice_serialization::natural_decimal(&actual), offset.to_string()),
+        _ => panic!("full replay must consume the exact global tape"),
+    }
+    assert_eq!(wasm_choice_serialization::trace_json(&final_state.trace), expected_trace);
+    wasm_serialization::module_json(&module)
+}
+
+#[test]
+fn full_replay_preserves_constant_global_types_mutability_and_naturals() {
+    for (width_cell, width) in [(0u64, "I32"), (1, "I64")] {
+        for (mutable_cell, mutable) in [(0u64, "Cons"), (1, "Var")] {
+            for number in [0u128, 1, 1 << 32, 1 << 64, 1 << 80, (1 << 80) + 5] {
+                let mut cells: Vec<u64> = vec![0, 1, width_cell, mutable_cell];
+                cells.extend(natural_cells(number));
+                let output: String = globals_report(1, cells);
+                let global: String = format!(
+                    "{{\"GTYPE\":{{\"GlobalT\":[\"{mutable}\",{{\"NumT\":\"{width}T\"}}]}},\"GINIT\":[{{\"CONST\":{{\"{width}\":{number}}}}}]}}"
+                );
+                assert!(output.contains(&format!("\"GLOBALS\":[{global}]")),
+                    "global type, mutability or initializer changed: {output}");
+            }
+        }
+    }
+}
+
+#[test]
+fn constant_global_section_exceeds_frontend_sample_size() {
+    let mut cells: Vec<u64> = vec![0];
+    let mut expected: Vec<String> = Vec::new();
+    for index in 0u64..129 {
+        cells.extend([1, index % 2, (index / 2) % 2, index]);
+        let width: &str = if index % 2 == 0 { "I32" } else { "I64" };
+        let mutable: &str = if (index / 2) % 2 == 0 { "Cons" } else { "Var" };
+        expected.push(format!(
+            "{{\"GTYPE\":{{\"GlobalT\":[\"{mutable}\",{{\"NumT\":\"{width}T\"}}]}},\"GINIT\":[{{\"CONST\":{{\"{width}\":{index}}}}}]}}"
+        ));
+    }
+    let output: String = globals_report(129, cells);
+    assert!(output.contains(&format!("\"GLOBALS\":[{}]", expected.join(","))),
+        "global section must preserve every type, initializer and its original order: {output}");
+}
