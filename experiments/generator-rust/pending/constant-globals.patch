+++ b/experiments/generator-rust/proofs/WasmGenerationResult.lean
@@ -0,0 +1,41 @@
+import GeneratorRust
+import Lean.Util.CollectAxioms
+
+set_option autoImplicit false
+
+namespace RustWasm
+open Aeneas.Std generator_rust
+
+theorem result_bind_success {α β : Type} (first : Result α) (next : α → Result β)
+    (output : β) (success : Aeneas.Std.bind first next = Result.ok output) :
+    ∃ intermediate, first = Result.ok intermediate ∧ next intermediate = Result.ok output := by
+  cases first with
+  | ret intermediate => exact ⟨intermediate, rfl, by simpa using success⟩
+  | vis effect continuation => simp at success
+  | div => simp at success
+
+/-- Invert a successful Rust result bind whose error arm preserves the error. -/
+theorem generation_bind_success {α β : Type}
+    (first : Result (core.result.Result α wasm.choices.GenerationError))
+    (next : core.result.Result α wasm.choices.GenerationError →
+      Result (core.result.Result β wasm.choices.GenerationError)) (output : β)
+    (success : Aeneas.Std.bind first next = Result.ok (.Ok output))
+    (errorRun : ∀ error, next (.Err error) = Result.ok (.Err error)) :
+    ∃ value, first = Result.ok (.Ok value) ∧ next (.Ok value) = Result.ok (.Ok output) := by
+  obtain ⟨result, firstRun, tail⟩ := result_bind_success first next (.Ok output) success
+  cases result with
+  | Ok value => exact ⟨value, firstRun, tail⟩
+  | Err error =>
+      rw [errorRun error] at tail
+      simp at tail
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``result_bind_success, ``generation_bind_success] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
diff --git a/experiments/generator-rust/proofs/WasmGlobalChoice.lean b/experiments/generator-rust/proofs/WasmGlobalChoice.lean
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmGlobalChoice.lean
@@ -0,0 +1,110 @@
+import WasmGlobalSpecification
+import WasmConstantReplay
+
+set_option autoImplicit false
+set_option maxHeartbeats 1600000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust wasm.ast
+
+def globalMutability : SpecTec.«mut» → Mutability
+  | .Cons => .Constant
+  | .Var => .Variable
+
+def globalMutabilityCell : SpecTec.«mut» → U64
+  | .Cons => 0#u64
+  | .Var => 1#u64
+
+def constantGlobalLiteral (item : ConstantGlobalInput) : Global :=
+  ⟨globalMutability item.mutability, integerValue item.width,
+    sequenceLiteral [integerConstantInstruction item.width (naturalLiteral item.value)]⟩
+
+def constantGlobalCells (item : ConstantGlobalInput) : List U64 :=
+  valueTypeCell item.width :: globalMutabilityCell item.mutability ::
+    naturalCells (naturalLiteral item.value)
+
+def constantGlobalSectionCells : List ConstantGlobalInput → List U64
+  | [] => []
+  | head :: tail => 1#u64 :: (constantGlobalCells head ++ constantGlobalSectionCells tail)
+
+/-- Exact source representation, with neither normalization nor a payload bound. -/
+theorem constant_global_embed (item : ConstantGlobalInput) :
+    globalEntry (constantGlobalLiteral item) = constantGlobalSpec item := by
+  rcases item with ⟨width, mutable, value⟩
+  cases width <;> cases mutable <;>
+    simp [globalEntry, constantGlobalLiteral, constantGlobalSpec, globalMutability,
+      mutability, integerValue, integerConstantInstruction, sequenceValues,
+      sequenceLiteral, instructionSequence, instruction, valueType]
+
+/-- Every width, mutability and natural payload has an exact actual entry execution. -/
+theorem constant_global_entry_replay (item : ConstantGlobalInput)
+    (rest trace : List U64) (offset work : Nat) :
+    wasm.global.entry
+      (replayState (constantGlobalCells item ++ rest) trace offset
+        (work + (constantGlobalCells item).length)) =
+      Result.ok (.Ok (constantGlobalLiteral item,
+        replayState rest ((constantGlobalCells item).reverse ++ trace)
+          (offset + (constantGlobalCells item).length) work)) := by
+  have widthBound : (valueTypeCell item.width).val < (2#u64).val := by
+    cases item.width <;> decide
+  have mutableBound : (globalMutabilityCell item.mutability).val < (2#u64).val := by
+    cases item.mutability <;> decide
+  have widthRun := pick_word_state 2#u64 (valueTypeCell item.width)
+    (globalMutabilityCell item.mutability :: naturalCells (naturalLiteral item.value) ++ rest)
+    trace offset (work + (naturalCells (naturalLiteral item.value)).length + 1) widthBound
+  have mutableRun := pick_word_state 2#u64 (globalMutabilityCell item.mutability)
+    (naturalCells (naturalLiteral item.value) ++ rest) (valueTypeCell item.width :: trace)
+    (offset + 1) (work + (naturalCells (naturalLiteral item.value)).length) mutableBound
+  have valueRun := natural_literal_choice item.value rest
+    (globalMutabilityCell item.mutability :: valueTypeCell item.width :: trace)
+    (offset + 2) work
+  rw [wasm.global.entry]
+  simp [constantGlobalCells, List.append_assoc, List.reverse_append,
+    Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] at widthRun mutableRun valueRun ⊢
+  rw [widthRun]
+  simp [core.result.Result.Insts.CoreOpsTry.branch]
+  rw [mutableRun]
+  simp [core.result.Result.Insts.CoreOpsTry.branch]
+  rw [valueRun]
+  rcases item with ⟨width, mutable, value⟩
+  cases width <;> cases mutable <;>
+    simp [constantGlobalLiteral, constantGlobalCells, valueTypeCell, globalMutabilityCell,
+      globalMutability, integerValue, integerConstantInstruction, sequenceLiteral,
+      wasm.sequence.cons, core.result.Result.Insts.CoreOpsTry.branch,
+      List.append_assoc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
+
+/-- Lists retain arbitrary length, order and duplicates through the actual section generator. -/
+theorem constant_global_section_replay (items : List ConstantGlobalInput)
+    (rest trace : List U64) (offset work : Nat) :
+    wasm.global.generate (naturalLiteral items.length)
+      (replayState (constantGlobalSectionCells items ++ rest) trace offset
+        (work + (constantGlobalSectionCells items).length)) =
+      Result.ok (.Ok (sequenceLiteral (items.map constantGlobalLiteral),
+        replayState rest ((constantGlobalSectionCells items).reverse ++ trace)
+          (offset + (constantGlobalSectionCells items).length) work)) := by
+  induction items generalizing rest trace offset work with
+  | nil =>
+      rw [wasm.global.generate]
+      simp [constantGlobalSectionCells, sequenceLiteral]
+  | cons head tail ih =>
+      have moreRun := pick_word_state 2#u64 1#u64
+        (constantGlobalCells head ++ (constantGlobalSectionCells tail ++ rest)) trace offset
+        (work + (constantGlobalSectionCells tail).length + (constantGlobalCells head).length)
+        (by decide)
+      have headRun := constant_global_entry_replay head
+        (constantGlobalSectionCells tail ++ rest) (1#u64 :: trace) (offset + 1)
+        (work + (constantGlobalSectionCells tail).length)
+      have tailRun := ih rest ((constantGlobalCells head).reverse ++ 1#u64 :: trace)
+        (offset + 1 + (constantGlobalCells head).length) work
+      rw [wasm.global.generate]
+      simp only [List.length_cons, decrement_literal]
+      simp [constantGlobalSectionCells, List.append_assoc, List.reverse_append,
+        Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] at moreRun headRun tailRun ⊢
+      rw [moreRun]
+      simp [core.result.Result.Insts.CoreOpsTry.branch]
+      rw [headRun]
+      simp [core.result.Result.Insts.CoreOpsTry.branch]
+      rw [tailRun]
+      simp [wasm.sequence.cons, sequenceLiteral]
+
+end RustWasm
diff --git a/experiments/generator-rust/proofs/WasmGlobalRepresentation.lean b/experiments/generator-rust/proofs/WasmGlobalRepresentation.lean
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmGlobalRepresentation.lean
@@ -0,0 +1,253 @@
+import WasmGlobalSupport
+import WasmImportInversion
+import Lean.Util.CollectAxioms
+
+set_option autoImplicit false
+set_option maxRecDepth 8000
+set_option maxHeartbeats 6000000
+
+namespace RustWasm
+open SpecTecExecution generator_rust.wasm.ast
+
+/-- Paired rule construction carries a kernel-checked functionality derivation. -/
+private def FunctionalExecution (plan : Action SpecTec.Request) (start : Nat)
+    (outcome : Outcome Value) (finish : Nat) : Prop :=
+  ∃ run : Eval SpecTec.Body plan start outcome finish, Functional SpecTec.Body run
+
+private theorem functional_pure {α : Type} (value : α) (supply : Nat) :
+    FunctionalExecution (.pure value) supply (.success (.of value)) supply :=
+  ⟨.pure value, .pure value⟩
+
+private theorem functional_unmatch (supply : Nat) :
+    FunctionalExecution .unmatch supply .unmatch supply :=
+  ⟨.unmatch, .unmatch⟩
+
+private theorem functional_guard_true {condition : Prop} (supply : Nat) (holds : condition) :
+    FunctionalExecution (.guard condition) supply (.success (.of ())) supply :=
+  ⟨.guard_true holds, .guard_true (h := holds)⟩
+
+private theorem functional_guard_false {condition : Prop} (supply : Nat) (fails : ¬ condition) :
+    FunctionalExecution (.guard condition) supply .unmatch supply :=
+  ⟨.guard_false fails, .guard_false (h := fails)⟩
+
+private theorem functional_call {request : SpecTec.Request} {start finish : Nat}
+    {outcome : Outcome Value}
+    (body : FunctionalExecution (SpecTec.Body request) start outcome finish) :
+    FunctionalExecution (.call request) start outcome finish := by
+  obtain ⟨run, functional⟩ := body
+  exact ⟨.call run, .call (h := run) functional⟩
+
+private theorem functional_bind_success {α : Type} {plan : Action SpecTec.Request}
+    {next : α → Action SpecTec.Request} {value : α} {outcome : Outcome Value}
+    {start middle finish : Nat}
+    (first : FunctionalExecution plan start (.success (.of value)) middle)
+    (second : FunctionalExecution (next value) middle outcome finish) :
+    FunctionalExecution (.bind plan next) start outcome finish := by
+  obtain ⟨head, headFunctional⟩ := first
+  obtain ⟨tail, tailFunctional⟩ := second
+  exact ⟨.bind_success head tail,
+    .bind_success (h := head) (k := tail) headFunctional tailFunctional⟩
+
+private theorem functional_bind_unmatch {α : Type} {plan : Action SpecTec.Request}
+    {next : α → Action SpecTec.Request} {start finish : Nat}
+    (first : FunctionalExecution plan start .unmatch finish) :
+    FunctionalExecution (.bind plan next) start .unmatch finish := by
+  obtain ⟨run, functional⟩ := first
+  exact ⟨.bind_unmatch run, .bind_unmatch (h := run) functional⟩
+
+private theorem functional_orElse_success {plan : Action SpecTec.Request}
+    {next : Unit → Action SpecTec.Request} {value : Value} {start finish : Nat}
+    (first : FunctionalExecution plan start (.success value) finish) :
+    FunctionalExecution (.orElse plan next) start (.success value) finish := by
+  obtain ⟨run, functional⟩ := first
+  exact ⟨.orElse_success run, .orElse_success (h := run) functional⟩
+
+private theorem functional_orElse_unmatch {plan : Action SpecTec.Request}
+    {next : Unit → Action SpecTec.Request} {outcome : Outcome Value}
+    {start failed finish : Nat}
+    (first : FunctionalExecution plan start .unmatch failed)
+    (second : FunctionalExecution (next ()) failed outcome finish) :
+    FunctionalExecution (.orElse plan next) start outcome finish := by
+  obtain ⟨head, headFunctional⟩ := first
+  obtain ⟨tail, tailFunctional⟩ := second
+  exact ⟨.orElse_unmatch head tail,
+    .orElse_unmatch (h := head) (k := tail) headFunctional tailFunctional⟩
+
+syntax "functional_constant_run" : tactic
+macro_rules
+| `(tactic| functional_constant_run) => `(tactic|
+  first
+  | exact functional_pure _ _
+  | exact functional_unmatch _
+  | (apply functional_guard_true; exact of_decide_eq_true rfl)
+  | (apply functional_guard_false; exact of_decide_eq_true rfl)
+  | (apply functional_call; functional_constant_run)
+  | (apply functional_bind_success; functional_constant_run; functional_constant_run)
+  | (apply functional_bind_unmatch; functional_constant_run)
+  | (apply functional_orElse_success; functional_constant_run)
+  | (apply functional_orElse_unmatch; functional_constant_run; functional_constant_run))
+
+def numericInitializer (width : IntegerType) (value : Nat) : SpecTec.const :=
+  [match width with | .I32 => .CONST (.I32 value) | .I64 => .CONST (.I64 value)]
+
+/-- These rejection proofs expose every actual rule step, including functionality. -/
+private theorem numeric_initializer_rejects_other_type
+    (context : SpecTec.context) (width : IntegerType) (value : Nat)
+    (target : SpecTec.valtype) (start : Nat)
+    (different : target ≠ valueType (integerValue width)) :
+    ∃ rejected : Eval SpecTec.Body
+      (.call ⟨Unit, SpecTec.Call.Const_ok context target (numericInitializer width value)⟩)
+      start .unmatch start, Functional SpecTec.Body rejected := by
+  change FunctionalExecution _ _ _ _
+  cases width <;> cases target with
+  | NumT numeric =>
+      cases numeric <;> first
+      | exact False.elim (different rfl)
+      | functional_constant_run
+  | VecT vector =>
+      functional_constant_run
+  | RefT reference =>
+      functional_constant_run
+  | BotT =>
+      functional_constant_run
+
+/-- Original validation must give a numeric initializer its exact numeric width. -/
+theorem numeric_const_target (context : SpecTec.context) (width : IntegerType)
+    (value : Nat) (target : SpecTec.valtype) (start finish : Nat)
+    (run : Eval SpecTec.Body
+      (.call ⟨Unit, SpecTec.Call.Const_ok context target (numericInitializer width value)⟩)
+      start (.success (.of ())) finish) :
+    target = valueType (integerValue width) := by
+  by_contra different
+  obtain ⟨_, functional⟩ :=
+    numeric_initializer_rejects_other_type context width value target start different
+  exact unmatch_excludes_success functional (.of ()) run
+
+/-- Retain the declared type while extracting the original initializer check. -/
+theorem global_numeric_representable (context output : SpecTec.context)
+    (entry : SpecTec.global) (width : IntegerType) (value : Nat)
+    (shape : entry.GINIT = numericInitializer width value) (start finish : Nat)
+    (run : Eval SpecTec.Body (.call ⟨SpecTec.context, SpecTec.Call.Global_ok context entry⟩)
+      start (.success (.of output)) finish) :
+    ∃ item : ConstantGlobalInput, constantGlobalSpec item = entry := by
+  rcases entry with ⟨⟨mutable, target⟩, initializer⟩
+  change initializer = numericInitializer width value at shape
+  subst initializer
+  cases run with
+  | call body =>
+      change Eval SpecTec.Body
+        (.orElse (SpecTec.«Global_ok:clause:0» context
+          ⟨.GlobalT mutable target, numericInitializer width value⟩) (fun _ => .unmatch))
+        start (.success (.of output)) finish at body
+      cases body with
+      | orElse_success checked =>
+          unfold SpecTec.«Global_ok:clause:0» at checked
+          cases checked with
+          | bind_success _ tail =>
+              cases tail with
+              | bind_success constant _ =>
+                  have same := numeric_const_target context width value target _ _ constant
+                  refine ⟨⟨width, mutable, value⟩, ?_⟩
+                  simp [constantGlobalSpec, numericInitializer, same]
+      | orElse_unmatch _ impossible => cases impossible
+
+/-- Recover exact canonical inputs from the successful original list validation. -/
+theorem globals_numeric_representable (context output : SpecTec.context)
+    (globals : List SpecTec.global) (start finish : Nat)
+    (run : Eval SpecTec.Body (.call ⟨SpecTec.context, SpecTec.Call.Globals_ok context globals⟩)
+      start (.success (.of output)) finish)
+    (shape : ∀ entry ∈ globals, ∃ width value, entry.GINIT = numericInitializer width value) :
+    ∃ items : List ConstantGlobalInput, items.map constantGlobalSpec = globals := by
+  induction globals generalizing context output start finish with
+  | nil => exact ⟨[], rfl⟩
+  | cons head tail ih =>
+      cases run with
+      | call body =>
+          change Eval SpecTec.Body
+            (.orElse (SpecTec.«Globals_ok:clause:0» context (head :: tail))
+              (fun _ => .orElse (SpecTec.«Globals_ok:clause:1» context (head :: tail))
+                (fun _ => .unmatch)))
+            start (.success (.of output)) finish at body
+          cases body with
+          | orElse_success checked =>
+              unfold SpecTec.«Globals_ok:clause:0» at checked
+              cases checked with
+              | bind_success _ rest =>
+                  cases rest with
+                  | bind_success headRun rest =>
+                      cases rest with
+                      | bind_success tailRun _ =>
+                          obtain ⟨width, value, headShape⟩ := shape head (by simp)
+                          obtain ⟨item, headEqual⟩ :=
+                            global_numeric_representable context _ head width value headShape _ _ headRun
+                          obtain ⟨items, tailEqual⟩ := ih _ _ _ _ tailRun
+                            (fun entry present => shape entry (by simp [present]))
+                          exact ⟨item :: items, by simp [headEqual, tailEqual]⟩
+          | orElse_unmatch _ rest =>
+              cases rest with
+              | orElse_success checked =>
+                  unfold SpecTec.«Globals_ok:clause:1» at checked
+                  cases checked with
+                  | bind_success guard _ =>
+                      cases guard with
+                      | guard_true impossible => simp at impossible
+              | orElse_unmatch _ impossible => cases impossible
+
+theorem module_globals_execution (module : SpecTec.module) (valid : SpecTec.Module_ok module) :
+    ∃ (context output : SpecTec.context) (start finish : Nat),
+      Eval SpecTec.Body (.call ⟨SpecTec.context, SpecTec.Call.Globals_ok context module.GLOBALS⟩)
+        start (.success (.of output)) finish := by
+  obtain ⟨finish, run⟩ := valid
+  cases run with
+  | call body =>
+      change Eval SpecTec.Body
+        (.orElse (SpecTec.«Module_ok:clause:0» module) (fun _ => .unmatch))
+        0 (.success (.of ())) finish at body
+      cases body with
+      | orElse_success checked =>
+          cases checked with
+          | bind_success _ tail =>
+              cases tail with
+              | bind_success _ tail =>
+                  cases tail with
+                  | bind_success _ tail =>
+                      cases tail with
+                      | bind_success _ tail =>
+                          cases tail with
+                          | bind_success _ tail =>
+                              cases tail with
+                              | bind_success _ tail =>
+                                  cases tail with
+                                  | bind_success _ tail =>
+                                      cases tail with
+                                      | bind_success globalsRun _ => exact ⟨_, _, _, _, globalsRun⟩
+      | orElse_unmatch _ impossible => cases impossible
+
+/-- The premise describes original initializer syntax, without assuming a matching declared type. -/
+theorem original_constant_globals_representable (globals : List SpecTec.global)
+    (valid : SpecTec.Module_ok { emptyModule with GLOBALS := globals })
+    (shape : ∀ entry ∈ globals, ∃ width value, entry.GINIT = numericInitializer width value) :
+    ∃ items : List ConstantGlobalInput, items.map constantGlobalSpec = globals := by
+  obtain ⟨context, output, start, finish, run⟩ := module_globals_execution _ valid
+  exact globals_numeric_representable context output globals start finish run shape
+
+theorem original_constant_globals_complete (globals : List SpecTec.global)
+    (valid : SpecTec.Module_ok { emptyModule with GLOBALS := globals })
+    (shape : ∀ entry ∈ globals, ∃ width value, entry.GINIT = numericInitializer width value) :
+    ∃ config, ReplaySupport config { emptyModule with GLOBALS := globals } := by
+  obtain ⟨items, equal⟩ := original_constant_globals_representable globals valid shape
+  rw [←equal]
+  exact ⟨constantGlobalsConfig items, constant_globals_supported items⟩
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``numeric_const_target, ``global_numeric_representable,
+      ``globals_numeric_representable, ``module_globals_execution,
+      ``original_constant_globals_representable, ``original_constant_globals_complete] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
diff --git a/experiments/generator-rust/proofs/WasmGlobalSoundness.lean b/experiments/generator-rust/proofs/WasmGlobalSoundness.lean
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmGlobalSoundness.lean
@@ -0,0 +1,166 @@
+import WasmGenerationResult
+import WasmGlobalChoice
+import Lean.Util.CollectAxioms
+
+set_option autoImplicit false
+set_option maxHeartbeats 1600000
+
+namespace RustWasm
+open Aeneas.Std generator_rust wasm.ast SpecTecExecution
+
+/-- Every successful actual entry preserves the correlation between type and initializer. -/
+theorem constant_global_constructor_sound (choices : wasm.choices.Choices)
+    (output : Global) (finalState : wasm.choices.Choices)
+    (success : wasm.global.entry choices = Result.ok (.Ok (output, finalState))) :
+    ∃ item : ConstantGlobalInput, globalEntry output = constantGlobalSpec item := by
+  rw [wasm.global.entry] at success
+  obtain ⟨⟨width, afterWidth⟩, _, tail⟩ :=
+    generation_bind_success (wasm.choices.pick_word 2#u64 choices) _ (output, finalState)
+      success (by
+        intro error
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+          core.convert.FromSame, core.convert.FromSame.from])
+  simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+    ↓uncurry_apply_pair] at tail
+  obtain ⟨⟨mutable, afterMutable⟩, _, tail⟩ :=
+    generation_bind_success (wasm.choices.pick_word 2#u64 afterWidth) _ (output, finalState)
+      tail (by
+        intro error
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+          core.convert.FromSame, core.convert.FromSame.from])
+  simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+    ↓uncurry_apply_pair] at tail
+  obtain ⟨⟨value, afterValue⟩, _, tail⟩ :=
+    generation_bind_success (wasm.choices.natural afterMutable) _ (output, finalState)
+      tail (by
+        intro error
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+          core.convert.FromSame, core.convert.FromSame.from])
+  simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+    ↓uncurry_apply_pair] at tail
+  refine ⟨⟨if width = 0#u64 then .I32 else .I64,
+    if mutable = 0#u64 then .Cons else .Var, naturalValue value⟩, ?_⟩
+  by_cases widthZero : width = 0#u64 <;> by_cases mutableZero : mutable = 0#u64
+  all_goals
+    simp [widthZero, mutableZero, wasm.sequence.cons] at tail
+    rcases tail with ⟨rfl, rfl⟩
+    simp [widthZero, mutableZero, globalEntry, constantGlobalSpec, mutability,
+      integerValue, valueType, instructionSequence, instruction, sequenceValues]
+
+private theorem constant_global_section_literal_sound (maximum : Nat)
+    (choices : wasm.choices.Choices) (output : wasm.sequence.Sequence Global)
+    (finalState : wasm.choices.Choices)
+    (success : wasm.global.generate (naturalLiteral maximum) choices =
+      Result.ok (.Ok (output, finalState))) :
+    ∃ items : List ConstantGlobalInput,
+      (sequenceValues output).map globalEntry = items.map constantGlobalSpec := by
+  induction maximum generalizing choices output finalState with
+  | zero =>
+      rw [wasm.global.generate] at success
+      simp only [decrement_zero, bind_ok, Result.ok.injEq,
+        core.result.Result.Ok.injEq, Prod.mk.injEq] at success
+      rcases success with ⟨rfl, rfl⟩
+      exact ⟨[], rfl⟩
+  | succ maximum ih =>
+      rw [wasm.global.generate] at success
+      simp only [decrement_literal, bind_ok] at success
+      obtain ⟨⟨more, afterMore⟩, _, tail⟩ :=
+        generation_bind_success (wasm.choices.pick_word 2#u64 choices) _ (output, finalState)
+          success (by
+            intro error
+            simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+              core.convert.FromSame, core.convert.FromSame.from])
+      simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+        ↓uncurry_apply_pair] at tail
+      by_cases stop : more = 0#u64
+      · simp [stop] at tail
+        rcases tail with ⟨rfl, rfl⟩
+        exact ⟨[], rfl⟩
+      · simp only [stop, ↓reduceIte] at tail
+        obtain ⟨⟨head, afterHead⟩, headRun, tail⟩ :=
+          generation_bind_success (wasm.global.entry afterMore) _ (output, finalState)
+            tail (by
+              intro error
+              simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+                core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+                core.convert.FromSame, core.convert.FromSame.from])
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          ↓uncurry_apply_pair] at tail
+        obtain ⟨⟨rest, afterRest⟩, restRun, tail⟩ :=
+          generation_bind_success (wasm.global.generate (naturalLiteral maximum) afterHead)
+            _ (output, finalState) tail (by
+              intro error
+              simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+                core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+                core.convert.FromSame, core.convert.FromSame.from])
+        simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok, bind_tc_ok,
+          ↓uncurry_apply_pair] at tail
+        obtain ⟨item, headEqual⟩ := constant_global_constructor_sound afterMore head afterHead headRun
+        obtain ⟨items, restEqual⟩ := ih afterHead rest afterRest restRun
+        simp [wasm.sequence.cons] at tail
+        rcases tail with ⟨rfl, rfl⟩
+        exact ⟨item :: items, by simp [sequenceValues, headEqual, restEqual]⟩
+
+/-- Shape preservation holds for any choice source and any natural section bound. -/
+theorem constant_global_section_sound (maximum : wasm.natural.Natural)
+    (choices : wasm.choices.Choices) (output : wasm.sequence.Sequence Global)
+    (finalState : wasm.choices.Choices)
+    (success : wasm.global.generate maximum choices = Result.ok (.Ok (output, finalState))) :
+    ∃ items : List ConstantGlobalInput,
+      (sequenceValues output).map globalEntry = items.map constantGlobalSpec := by
+  have canonical : maximum = naturalLiteral (naturalValue maximum) := by
+    apply naturalValue_injective
+    simp
+  rw [canonical] at success
+  exact constant_global_section_literal_sound (naturalValue maximum) choices output finalState success
+
+theorem constant_global_section_valid (maximum : wasm.natural.Natural)
+    (choices : wasm.choices.Choices) (output : wasm.sequence.Sequence Global)
+    (finalState : wasm.choices.Choices)
+    (success : wasm.global.generate maximum choices = Result.ok (.Ok (output, finalState))) :
+    SpecTec.Module_ok { emptyModule with GLOBALS := (sequenceValues output).map globalEntry } := by
+  obtain ⟨items, equal⟩ := constant_global_section_sound maximum choices output finalState success
+  rw [equal]
+  exact constant_globals_module_valid items
+
+/-- Successful global sections append exactly their declared types in every context. -/
+theorem constant_global_section_execute (context : SpecTec.context) (supply : Nat)
+    (maximum : wasm.natural.Natural) (choices : wasm.choices.Choices)
+    (output : wasm.sequence.Sequence Global) (finalState : wasm.choices.Choices)
+    (success : wasm.global.generate maximum choices = Result.ok (.Ok (output, finalState))) :
+    Eval SpecTec.Body (.call ⟨SpecTec.context,
+      SpecTec.Call.Globals_ok context ((sequenceValues output).map globalEntry)⟩)
+      supply (.success (.of { context with GLOBALS := context.GLOBALS ++
+        ((sequenceValues output).map globalEntry).map SpecTec.global.GTYPE })) supply := by
+  obtain ⟨items, equal⟩ := constant_global_section_sound maximum choices output finalState success
+  rw [equal]
+  simpa [List.map_map] using constant_globals_execute context items supply
+
+theorem constant_global_section_free_execute (supply : Nat)
+    (maximum : wasm.natural.Natural) (choices : wasm.choices.Choices)
+    (output : wasm.sequence.Sequence Global) (finalState : wasm.choices.Choices)
+    (success : wasm.global.generate maximum choices = Result.ok (.Ok (output, finalState))) :
+    Eval SpecTec.Body (.call ⟨SpecTec.free,
+      SpecTec.Call.«$free_list» SpecTec.global SpecTec.Call.«$free_global»
+        ((sequenceValues output).map globalEntry)⟩)
+      supply (.success (.of memoryFree)) supply := by
+  obtain ⟨items, equal⟩ := constant_global_section_sound maximum choices output finalState success
+  rw [equal]
+  exact constant_globals_free_execute items supply
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``constant_global_constructor_sound, ``constant_global_section_sound,
+      ``constant_global_section_valid, ``constant_global_section_execute,
+      ``constant_global_section_free_execute] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
diff --git a/experiments/generator-rust/proofs/WasmGlobalSpecification.lean b/experiments/generator-rust/proofs/WasmGlobalSpecification.lean
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmGlobalSpecification.lean
@@ -0,0 +1,105 @@
+import WasmConstantSpecification
+import WasmMemorySpecification
+import WasmModulePrimitives
+
+set_option autoImplicit false
+set_option maxRecDepth 8000
+set_option maxHeartbeats 6000000
+
+namespace RustWasm
+open SpecTecExecution generator_rust.wasm.ast
+
+/-- Inputs to the numeric constant constructor, with original mutability and unbounded payload. -/
+structure ConstantGlobalInput where
+  width : IntegerType
+  mutability : SpecTec.«mut»
+  value : Nat
+
+def constantGlobalSpec (item : ConstantGlobalInput) : SpecTec.global :=
+  ⟨.GlobalT item.mutability (valueType (integerValue item.width)),
+    [match item.width with | .I32 => .CONST (.I32 item.value) | .I64 => .CONST (.I64 item.value)]⟩
+
+/-- Only the numeric constant constructor has this empty free-index set. -/
+theorem constant_global_free_execute (item : ConstantGlobalInput) (supply : Nat) :
+    Eval SpecTec.Body (.call ⟨SpecTec.free, SpecTec.Call.«$free_global» (constantGlobalSpec item)⟩)
+      supply (.success (.of memoryFree)) supply := by
+  rcases item with ⟨width, mutability, value⟩
+  cases width <;> constant_spec_run
+
+theorem constant_globals_free_execute (items : List ConstantGlobalInput) (supply : Nat) :
+    Eval SpecTec.Body (.call ⟨SpecTec.free,
+      SpecTec.Call.«$free_list» SpecTec.global SpecTec.Call.«$free_global»
+        (items.map constantGlobalSpec)⟩)
+      supply (.success (.of memoryFree)) supply := by
+  induction items with
+  | nil => constant_spec_run
+  | cons head tail ih =>
+      apply Eval.call
+      apply Eval.orElse_unmatch
+      · apply Eval.bind_unmatch
+        apply Eval.guard_false
+        exact of_decide_eq_true rfl
+      · apply Eval.orElse_success
+        apply Eval.bind_success
+        · apply Eval.guard_true
+          exact of_decide_eq_true rfl
+        · apply Eval.bind_success
+          · exact constant_global_free_execute head supply
+          · apply Eval.bind_success
+            · exact ih
+            · constant_spec_run
+
+/-- Both mutabilities use the exact original constant-expression and global-type rules. -/
+theorem constant_global_execute (context : SpecTec.context) (item : ConstantGlobalInput)
+    (supply : Nat) :
+    Eval SpecTec.Body (.call ⟨SpecTec.context, SpecTec.Call.Global_ok context (constantGlobalSpec item)⟩)
+      supply (.success (.of { context with
+        GLOBALS := context.GLOBALS ++ [(constantGlobalSpec item).GTYPE] })) supply := by
+  rcases item with ⟨width, mutability, value⟩
+  cases width <;> constant_spec_run
+
+theorem constant_globals_execute (context : SpecTec.context) (items : List ConstantGlobalInput)
+    (supply : Nat) :
+    Eval SpecTec.Body (.call ⟨SpecTec.context,
+      SpecTec.Call.Globals_ok context (items.map constantGlobalSpec)⟩)
+      supply (.success (.of { context with
+        GLOBALS := context.GLOBALS ++ items.map (fun item => (constantGlobalSpec item).GTYPE) })) supply := by
+  induction items generalizing context with
+  | nil =>
+      simp only [List.map_nil, List.append_nil]
+      constant_spec_run
+  | cons head tail ih =>
+      apply Eval.call
+      apply Eval.orElse_success
+      apply Eval.bind_success
+      · apply Eval.guard_true
+        exact of_decide_eq_true rfl
+      · apply Eval.bind_success
+        · exact constant_global_execute context head supply
+        · apply Eval.bind_success
+          · exact ih { context with GLOBALS := context.GLOBALS ++ [(constantGlobalSpec head).GTYPE] }
+          · simp only [List.map_cons, List.append_assoc, List.singleton_append]
+            exact Eval.pure _
+
+syntax "constant_globals_spec_run" : tactic
+macro_rules
+| `(tactic| constant_globals_spec_run) => `(tactic|
+  first
+  | exact constant_globals_free_execute _ _
+  | exact constant_globals_execute _ _ _
+  | exact Eval.pure _
+  | exact Eval.unmatch
+  | (apply Eval.guard_true; exact of_decide_eq_true rfl)
+  | (apply Eval.guard_false; exact of_decide_eq_true rfl)
+  | (apply Eval.call; constant_globals_spec_run)
+  | (apply Eval.bind_success; constant_globals_spec_run; constant_globals_spec_run)
+  | (apply Eval.bind_unmatch; constant_globals_spec_run)
+  | (apply Eval.orElse_success; constant_globals_spec_run)
+  | (apply Eval.orElse_unmatch; constant_globals_spec_run; constant_globals_spec_run))
+
+theorem constant_globals_module_valid (items : List ConstantGlobalInput) :
+    SpecTec.Module_ok { emptyModule with GLOBALS := items.map constantGlobalSpec } := by
+  refine ⟨0, ?_⟩
+  constant_globals_spec_run
+
+end RustWasm
diff --git a/experiments/generator-rust/proofs/WasmGlobalSupport.lean b/experiments/generator-rust/proofs/WasmGlobalSupport.lean
new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmGlobalSupport.lean
@@ -0,0 +1,80 @@
+import WasmGlobalChoice
+import Lean.Util.CollectAxioms
+
+set_option autoImplicit false
+set_option maxHeartbeats 1600000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust wasm.ast
+
+def constantGlobalsConfig (items : List ConstantGlobalInput) : wasm.Config :=
+  { emptyConfig with
+    max_globals := naturalLiteral items.length
+    work_limit := naturalLiteral ((constantGlobalSectionCells items).length + 1) }
+
+def constantGlobalsOutput (items : List ConstantGlobalInput) : wasm.ast.Module :=
+  { emptyOutput with globals := sequenceLiteral (items.map constantGlobalLiteral) }
+
+def constantGlobalsFinal (items : List ConstantGlobalInput) : wasm.choices.Choices :=
+  replayState [] ((constantGlobalSectionCells items).reverse ++ [0#u64])
+    ((constantGlobalSectionCells items).length + 1) 0
+
+/-- Exact full replay traverses every module stage and consumes the complete finite tape. -/
+theorem constant_globals_replay (items : List ConstantGlobalInput) :
+    wasm.replay (constantGlobalsConfig items)
+      (tapeFromCells (0#u64 :: constantGlobalSectionCells items)) =
+      Result.ok (.Ok (constantGlobalsOutput items, constantGlobalsFinal items)) := by
+  apply replay_from_build (constantGlobalsConfig items) _ _ (constantGlobalsFinal items)
+    (naturalLiteral ((constantGlobalSectionCells items).length + 1)) ?_ rfl
+  let afterTypes := replayState (constantGlobalSectionCells items) [0#u64] 1
+    (constantGlobalSectionCells items).length
+  apply build_empty_types (constantGlobalsConfig items) _ afterTypes afterTypes
+    (constantGlobalsFinal items) (constantGlobalsFinal items) (constantGlobalsFinal items)
+    .Empty (sequenceLiteral (items.map constantGlobalLiteral)) .Empty .Empty
+  · exact generate_types_zero (constantGlobalsConfig items) rfl
+      (constantGlobalSectionCells items) [] 0 (constantGlobalSectionCells items).length
+  · rw [wasm.memory_import.generate]
+    simp [constantGlobalsConfig, emptyConfig, wasm.natural.decrement]
+  · have generated := constant_global_section_replay items [] [0#u64] 1 0
+    simpa [constantGlobalsConfig, constantGlobalsFinal, afterTypes, Nat.add_comm] using generated
+  · rw [wasm.memory.generate]
+    simp [constantGlobalsConfig, emptyConfig, wasm.natural.decrement]
+  · rw [wasm.data.generate]
+    simp [constantGlobalsConfig, emptyConfig, wasm.natural.decrement]
+
+theorem constant_globals_supported (items : List ConstantGlobalInput) :
+    ReplaySupport (constantGlobalsConfig items)
+      { emptyModule with GLOBALS := items.map constantGlobalSpec } := by
+  refine ⟨tapeFromCells (0#u64 :: constantGlobalSectionCells items), constantGlobalsOutput items,
+    ⟨constantGlobalsFinal items, constant_globals_replay items⟩, ?_⟩
+  simp [embed, constantGlobalsOutput, emptyOutput, emptyModule, memoryOnly,
+    sequenceValues, sequenceLiteral, memories, datas, List.map_map, Function.comp_def,
+    constant_global_embed]
+
+theorem constant_globals_generated_valid (items : List ConstantGlobalInput) :
+    ReplaySupport (constantGlobalsConfig items)
+      { emptyModule with GLOBALS := items.map constantGlobalSpec } ∧
+      SpecTec.Module_ok { emptyModule with GLOBALS := items.map constantGlobalSpec } :=
+  ⟨constant_globals_supported items, constant_globals_module_valid items⟩
+
+/-- The former immutable-global counterexample now has exact actual replay support. -/
+theorem globalsOnly_supported :
+    ∃ config, ReplaySupport config globalsOnly := by
+  refine ⟨constantGlobalsConfig [⟨.I32, .Cons, 0⟩], ?_⟩
+  simpa [constantGlobalSpec, globalsOnly, integerValue, valueType] using
+    constant_globals_supported [⟨.I32, .Cons, 0⟩]
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``constant_global_free_execute, ``constant_globals_free_execute,
+      ``constant_global_execute, ``constant_globals_execute, ``constant_globals_module_valid,
+      ``constant_global_embed, ``constant_global_entry_replay, ``constant_global_section_replay,
+      ``constant_globals_replay, ``constant_globals_supported,
+      ``constant_globals_generated_valid, ``globalsOnly_supported] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
