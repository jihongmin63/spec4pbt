new file mode 100644
--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmReplayPrefix.lean
@@ -0,0 +1,66 @@
+import WasmFiniteChoice
+
+set_option autoImplicit false
+set_option maxHeartbeats 1200000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust
+
+/-- A stage preserves its continuation state, with work cost independent of tape length. -/
+def ReplayPrefix {α : Type}
+    (stage : wasm.choices.Choices → Result (core.result.Result (α × wasm.choices.Choices)
+      wasm.choices.GenerationError))
+    (output : α) (cells : List U64) (cost : Nat) : Prop :=
+  ∀ (rest trace : List U64) (offset work : Nat),
+    stage (replayState (cells ++ rest) trace offset (work + cost)) =
+      Result.ok (.Ok (output,
+        replayState rest (cells.reverse ++ trace) (offset + cells.length) work))
+
+theorem replay_prefix_pure {α : Type} (output : α) :
+    ReplayPrefix (fun choices => Result.ok (.Ok (output, choices))) output [] 0 := by
+  intro rest trace offset work
+  simp
+
+/-- The actual Rust question-mark operation composes successful construction stages. -/
+theorem replay_prefix_bind {α β : Type}
+    (first : wasm.choices.Choices → Result (core.result.Result (α × wasm.choices.Choices)
+      wasm.choices.GenerationError))
+    (next : α → wasm.choices.Choices → Result (core.result.Result (β × wasm.choices.Choices)
+      wasm.choices.GenerationError))
+    (intermediate : α) (output : β) (firstCells nextCells : List U64)
+    (firstCost nextCost : Nat)
+    (firstRun : ReplayPrefix first intermediate firstCells firstCost)
+    (nextRun : ReplayPrefix (next intermediate) output nextCells nextCost) :
+    ReplayPrefix (fun choices => do
+      let result ← first choices
+      let branch ← core.result.Result.Insts.CoreOpsTry.branch result
+      match branch with
+      | core.ops.control_flow.ControlFlow.Continue pair => next pair.1 pair.2
+      | core.ops.control_flow.ControlFlow.Break residual =>
+          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
+            (β × wasm.choices.Choices) (core.convert.FromSame wasm.choices.GenerationError) residual)
+      output (firstCells ++ nextCells) (firstCost + nextCost) := by
+  intro rest trace offset work
+  have firstStep := firstRun (nextCells ++ rest) trace offset (work + nextCost)
+  have nextStep := nextRun rest (firstCells.reverse ++ trace) (offset + firstCells.length) work
+  simp only [List.append_assoc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] at firstStep nextStep ⊢
+  rw [firstStep]
+  simp only [bind_ok, bind_tc_ok, core.result.Result.Insts.CoreOpsTry.branch]
+  rw [nextStep]
+  simp [List.reverse_append, List.append_assoc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
+
+theorem choose_replay_prefix {α : Type} (values : List α) (value : α)
+    (present : value ∈ values) :
+    ∃ cells, ReplayPrefix (wasm.choose (sequenceLiteral values)) value cells cells.length :=
+  choose_replay values value present
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``replay_prefix_pure, ``replay_prefix_bind, ``choose_replay_prefix] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
