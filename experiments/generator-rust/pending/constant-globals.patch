--- /dev/null
+++ b/experiments/generator-rust/proofs/WasmFiniteChoice.lean
@@ -0,0 +1,86 @@
+import WasmNaturalIndex
+import WasmSequence
+
+set_option autoImplicit false
+set_option maxHeartbeats 1200000
+
+namespace RustWasm
+open Aeneas Aeneas.Std generator_rust
+
+/-- Every listed alternative has an exact actual-Rust replay prefix. -/
+theorem choose_replay {α : Type} (values : List α) (value : α) (present : value ∈ values) :
+    ∃ cells : List U64, ∀ (rest trace : List U64) (offset work : Nat),
+      wasm.choose (sequenceLiteral values)
+        (replayState (cells ++ rest) trace offset (work + cells.length)) =
+        Result.ok (.Ok (value,
+          replayState rest (cells.reverse ++ trace) (offset + cells.length) work)) := by
+  obtain ⟨index, inRange, selected⟩ := List.getElem_of_mem present
+  obtain ⟨cells, replay⟩ := natural_index_replay values.length index inRange
+  refine ⟨cells, ?_⟩
+  intro rest trace offset work
+  have found : values[index]? = some value := by simp [List.getElem?_eq_getElem, inRange, selected]
+  simp [wasm.choose, sequence_length, replay rest trace offset work,
+    sequence_select, found, core.result.Result.Insts.CoreOpsTry.branch,
+    ↓uncurry_apply_pair]
+
+theorem choose_spec {α : Type} (values : List α) (choices : wasm.choices.Choices) :
+    wasm.choose (sequenceLiteral values) choices ⦃ result =>
+      match result with
+      | .Err _ => True
+      | .Ok (value, _) => value ∈ values ⦄ := by
+  rw [wasm.choose, sequence_length]
+  simp only [bind_ok, bind_tc_ok]
+  apply WP.spec_bind (natural_index_spec values.length choices)
+  intro result _
+  cases result with
+  | Err error =>
+      simp [core.result.Result.Insts.CoreOpsTry.branch,
+        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,
+        core.convert.FromSame, core.convert.FromSame.from]
+  | Ok pair =>
+      rcases pair with ⟨index, finalState⟩
+      have canonical : index = naturalLiteral (naturalValue index) := by
+        apply naturalValue_injective
+        simp
+      have selected : wasm.sequence.select (sequenceLiteral values) index =
+          Result.ok values[naturalValue index]? := by
+        conv_lhs => rw [canonical]
+        exact sequence_select values (naturalValue index)
+      simp only [core.result.Result.Insts.CoreOpsTry.branch, ↓uncurry_apply_pair,
+        bind_ok, bind_tc_ok, selected]
+      cases found : values[naturalValue index]? with
+      | none => simp [found]
+      | some value => simpa [found] using List.mem_of_getElem? found
+
+/-- Soundness covers all successful choice sources, not just constructed tapes. -/
+theorem choose_sound {α : Type} (values : List α) (value : α)
+    (choices finalState : wasm.choices.Choices)
+    (success : wasm.choose (sequenceLiteral values) choices = Result.ok (.Ok (value, finalState))) :
+    value ∈ values := by
+  have correct := choose_spec values choices
+  rw [success] at correct
+  simpa using correct
+
+theorem choose_support_exact {α : Type} (values : List α) (value : α) :
+    (∃ choices finalState,
+      wasm.choose (sequenceLiteral values) choices = Result.ok (.Ok (value, finalState))) ↔
+      value ∈ values := by
+  constructor
+  · rintro ⟨choices, finalState, success⟩
+    exact choose_sound values value choices finalState success
+  · intro present
+    obtain ⟨cells, replay⟩ := choose_replay values value present
+    refine ⟨replayState cells [] 0 cells.length,
+      replayState [] cells.reverse cells.length 0, ?_⟩
+    simpa using replay [] [] 0 0
+
+open Lean Elab Command in
+run_cmd do
+  for declaration in [``choose_replay, ``choose_spec, ``choose_sound, ``choose_support_exact] do
+    let axioms ← liftCoreM (collectAxioms declaration)
+    for dependency in axioms do
+      unless [``propext, ``Classical.choice, ``Quot.sound].contains dependency do
+        throwError "{declaration} depends on forbidden axiom {dependency}"
+    logInfo m!"{declaration}: checked; axioms = {axioms.toList}"
+
+end RustWasm
