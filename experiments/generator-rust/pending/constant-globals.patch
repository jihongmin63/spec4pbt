+use super::ast::{Global, Instruction, Mutability, ValueType};
+use super::choices::{self, pick_word, Choices, GenerationError};
+use super::natural::{self, Natural};
+use super::sequence::{self, Sequence};
+
+/// Construct original constant expressions directly, with arbitrary natural payloads.
+fn entry(choices: Choices) -> Result<(Global, Choices), GenerationError> {
+    let (width, choices): (u64, Choices) = pick_word(2, choices)?;
+    let (mutable, choices): (u64, Choices) = pick_word(2, choices)?;
+    let (value, choices): (Natural, Choices) = choices::natural(choices)?;
+    let mutability: Mutability = if mutable == 0 { Mutability::Constant } else { Mutability::Variable };
+    let (value_type, instruction): (ValueType, Instruction) = if width == 0 {
+        (ValueType::I32, Instruction::Const32(value))
+    } else {
+        (ValueType::I64, Instruction::Const64(value))
+    };
+    Ok((Global { mutability, value_type, initializer: sequence::cons(instruction, Sequence::Empty) }, choices))
+}
+
+/// The section bound and representation have no machine-sized length restriction.
+pub fn generate(maximum: Natural, choices: Choices)
+    -> Result<(Sequence<Global>, Choices), GenerationError>
+{
+    let remaining: Natural = match natural::decrement(maximum) {
+        None => return Ok((Sequence::Empty, choices)),
+        Some(remaining) => remaining,
+    };
+    let (more, choices): (u64, Choices) = pick_word(2, choices)?;
+    if more == 0 {
+        return Ok((Sequence::Empty, choices));
+    }
+    let (head, choices): (Global, Choices) = entry(choices)?;
+    let (tail, choices): (Sequence<Global>, Choices) = generate(remaining, choices)?;
+    Ok((sequence::cons(head, tail), choices))
+}
